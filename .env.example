# ==============================================================================
# Short.ly — Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit the real .env file.
# ==============================================================================

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Atlas M0 connection string (free tier)
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=shortly

# ── Redis (Upstash free tier) ─────────────────────────────────────────────────
# rediss:// scheme = TLS (required by Upstash)
REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

# ── Kafka (Upstash Kafka free tier) ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=<cluster>.upstash.io:9092
KAFKA_USERNAME=<upstash-kafka-username>
KAFKA_PASSWORD=<upstash-kafka-password>

# ── Service URLs (used by api-gateway) ────────────────────────────────────────
# In docker-compose, use Docker service names
LINK_SERVICE_URL=http://link-service:8001
REDIRECT_SERVICE_URL=http://redirect-service:8002

# ── Public base URL (used by link-service to build short URLs) ─────────────────
# In production, set to your api-gateway Render URL or custom domain
BASE_URL=http://localhost:8000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# The api-gateway public URL that the browser talks to
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS (api-gateway) ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev.
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-url.vercel.app

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_INTERVAL_MINUTES=15

# ── Redis TTL default (seconds) ───────────────────────────────────────────────
REDIS_DEFAULT_TTL=2592000
