{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Short.ly — Service Observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Request Rate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Requests / second by endpoint",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler, method, status)",
          "legendFormat": "{{method}} {{handler}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (link-service)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"link-service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"link-service\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"link-service\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cache & Rate Limit",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "id": 5,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redis_cache_hits_total / (redis_cache_hits_total + redis_cache_misses_total)",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Redis Cache Hits vs Misses",
      "id": 6,
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 10 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(redis_cache_hits_total[1m])", "legendFormat": "Hits/s" },
        { "expr": "rate(redis_cache_misses_total[1m])", "legendFormat": "Misses/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Rejections / second",
      "id": 7,
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 10 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(rate_limit_rejections_total[1m])", "legendFormat": "Rejections/s" }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#E05252", "mode": "fixed" } } }
    },
    {
      "type": "row",
      "title": "Redirect Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (redirect-service)",
      "id": 9,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"redirect-service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"redirect-service\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"redirect-service\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["shortly"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Short.ly Observability",
  "uid": "shortly-main",
  "version": 1
}
